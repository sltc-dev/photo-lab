generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // cuid 由 Prisma 在创建用户时生成，不依赖数据库自增序列。
  id                   String                @id @default(cuid())
  // email 是登录标识，唯一约束由数据库做最终并发裁决。
  email                String                @unique
  username             String
  // 这里只保存 Argon2id Hash，绝不保存可以直接登录的明文密码。
  passwordHash         String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  // 关系字段不是真实数组列，它表示“一位用户可以拥有多条 RefreshToken 记录”。
  refreshTokens        RefreshToken[]
  projects             Project[]
  photoLikes           PhotoLike[]
  photoFavorites       PhotoFavorite[]
  photoComments        PhotoComment[]
  stickers             UserSticker[]
  notificationReceipts NotificationReceipt[]
  feedbacks            Feedback[]
  notifications        Notification[]
}

enum FeedbackCategory {
  BUG
  FEATURE
  OTHER
}

model Feedback {
  id          String           @id @default(cuid())
  referenceId String           @unique
  userId      String
  category    FeedbackCategory
  message     String           @db.VarChar(2000)
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  // 数据库只保存原始 Refresh Token 的 Hash；原始值仅在签发时返回给客户端。
  tokenHash String    @unique
  expiresAt DateTime
  // null 表示仍可使用；有时间值表示它已被刷新或退出操作撤销。
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  // 删除用户时同时删除其 Refresh Token，避免留下无法归属的记录。
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum PhotoStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum PhotoKind {
  ORIGINAL
  EDITED
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      Photo[]

  @@index([userId, createdAt])
}

model Photo {
  id                  String          @id @default(cuid())
  projectId           String
  fileName            String
  relativePath        String
  mimeType            String
  sizeBytes           Int
  width               Int?
  height              Int?
  kind                PhotoKind       @default(ORIGINAL)
  checksumSha256      String?
  originalObjectKey   String          @unique
  previewObjectKey    String?
  editState           Json?
  thumbnailObjectKey  String?
  status              PhotoStatus     @default(UPLOADED)
  processingAttempts  Int             @default(0)
  processingError     String?
  processingStartedAt DateTime?
  nextAttemptAt       DateTime        @default(now())
  likeCount           Int             @default(0)
  favoriteCount       Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  likes               PhotoLike[]
  favorites           PhotoFavorite[]
  comments            PhotoComment[]

  @@index([projectId, createdAt])
  @@index([projectId, kind, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, processingStartedAt])
}

model PhotoLike {
  userId    String
  photoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([photoId, createdAt])
}

model PhotoFavorite {
  userId    String
  photoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([userId, photoId])
  @@index([photoId, createdAt])
}

model PhotoComment {
  id         String   @id @default(cuid())
  photoId    String
  userId     String
  content    String?  @db.VarChar(500)
  stickerKey String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  photo      Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([photoId, createdAt, id])
  @@index([userId])
}

model UserSticker {
  id        String    @id @default(cuid())
  userId    String
  objectKey String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NotificationType {
  SYSTEM
  VERSION_UPGRADE
}

enum NotificationLevel {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id              String                @id @default(cuid())
  type            NotificationType      @default(SYSTEM)
  level           NotificationLevel     @default(INFO)
  title           String
  summary         String
  content         String
  targetVersion   String?
  publishedAt     DateTime              @default(now())
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  // null 表示面向所有用户的全体通知；有用户 ID 时表示仅该用户可见的个人通知。
  recipientUserId String?
  recipient       User?                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  // 每位用户的已读状态单独保存在 NotificationReceipt 中，不影响其他用户。
  receipts        NotificationReceipt[]

  @@index([publishedAt, id])
  @@index([expiresAt])
  @@index([recipientUserId, publishedAt, id])
}

model NotificationReceipt {
  userId         String
  notificationId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@index([notificationId])
}
