      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "format": "email"
          },
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ]
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "username": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "createdAt",
          "updatedAt"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "AUTH_INVALID_CREDENTIALS",
          "AUTH_REFRESH_TOKEN_INVALID",
          "AUTH_TOKEN_EXPIRED",
          "BAD_REQUEST",
          "HTTP_ERROR",
          "INTERNAL_SERVER_ERROR",
          "NOT_FOUND",
          "RATE_LIMIT_EXCEEDED",
          "USER_EMAIL_ALREADY_EXISTS",
          "USER_NOT_FOUND",
          "VALIDATION_FAILED"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "details": {
            "type": "object",
            "nullable": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ]
      },
