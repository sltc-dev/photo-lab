  "info": {
    "title": "Photo Lab API",
    "description": "Generated OpenAPI contract for Photo Lab clients.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "format": "email"
          },
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ]
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "username": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "createdAt",
          "updatedAt"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "AUTH_INVALID_CREDENTIALS",
          "AUTH_REFRESH_TOKEN_INVALID",
          "AUTH_TOKEN_EXPIRED",
          "BAD_REQUEST",
          "HTTP_ERROR",
          "INTERNAL_SERVER_ERROR",
          "NOT_FOUND",
          "PHOTO_FILE_REQUIRED",
          "PHOTO_FILE_TOO_LARGE",
          "PHOTO_NOT_FOUND",
          "PHOTO_STORAGE_FAILED",
          "PHOTO_UNSUPPORTED_TYPE",
          "PROJECT_NOT_FOUND",
          "RATE_LIMIT_EXCEEDED",
          "USER_EMAIL_ALREADY_EXISTS",
          "USER_NOT_FOUND",
          "VALIDATION_FAILED"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "details": {
            "type": "object",
            "nullable": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 32
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 32
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutResultDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "2026 夏季旅行",
            "maxLength": 100,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "example": "用于整理夏季旅行拍摄的照片",
            "maxLength": 500
          }
        },
        "required": [
          "name"
        ]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "photoCount": {
            "type": "number",
            "description": "项目中的图片数量",
            "example": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "photoCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "PhotoStatus": {
        "type": "string",
        "enum": [
          "UPLOADED",
          "PROCESSING",
          "READY",
          "FAILED"
        ]
      },
      "PhotoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "fileName": {
            "type": "string",
            "description": "用户上传时的原始文件名"
          },
          "mimeType": {
            "type": "string",
            "example": "image/jpeg"
          },
          "originalUrl": {
            "type": "string",
            "description": "原始图片的 API 相对 URL",
            "example": "/public/projects/project-id/photos/photo-id--holiday.jpg"
          },
          "thumbnailUrl": {
            "type": "string",
            "description": "缩略图的 API 相对 URL",
            "example": "/public/projects/project-id/photos/photo-id--holiday.thumbnail.webp"
          },
          "sizeBytes": {
            "type": "number",
            "description": "原始图片大小，单位为字节",
            "example": 4839201
          },
          "width": {
            "type": "number",
            "nullable": true
          },
          "height": {
            "type": "number",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PhotoStatus"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "projectId",
          "fileName",
          "mimeType",
          "originalUrl",
          "thumbnailUrl",
