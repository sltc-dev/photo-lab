NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://photo_lab:photo_lab@localhost:5432/photo_lab?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-another-16-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,file://
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
REDIS_URL=redis://localhost:6379
PHOTO_STORAGE_ROOT=../../public/photo-lab
PHOTO_UPLOAD_MAX_BYTES=26214400

# Reserved for the future MinIO-backed StorageService implementation.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=photo_lab_minio
MINIO_SECRET_KEY=photo_lab_minio_secret
VITE_API_BASE_URL=http://localhost:3000
VITE_ENABLE_QUERY_DEVTOOLS=false

# Optional host port overrides for Docker Compose.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=3000
