{
  "name": "photo-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "api:openapi": "pnpm --filter api openapi",
    "api:client": "pnpm api:openapi && pnpm --filter desktop generate:api-client",
    "api:client:check": "pnpm api:client && git diff --exit-code packages/api-contract/openapi.json apps/desktop/src/generated/api",
    "notification:publish": "pnpm --filter api notifications:publish",
    "db:validate": "pnpm --filter api prisma validate",
    "db:migrate": "pnpm db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter api prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter api prisma migrate dev",
    "db:generate": "pnpm --filter api prisma generate",
    "docker:infra": "docker compose up -d postgres redis minio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.38.0"
  }
}
